<div id="remoteslicing_tab" class="remoteslicing">
    <div class="rs-status" data-bind="css: {'rs-online': agentOnline, 'rs-offline': !agentOnline()}">
        <span class="rs-dot"></span>
        <strong data-bind="text: agentOnline() ? 'PC agent online' : 'PC agent offline'"></strong>
        <span class="muted" data-bind="visible: !agentOnline(), text: '· last seen ' + lastSeenText()"></span>
        <span class="rs-status-settings" data-bind="text: settingsText"></span>
    </div>

    <div class="rs-columns">
        <div class="rs-main">
            <div class="rs-plate-head">
                <label for="remoteslicing_plate_name">Plate</label>
                <input type="text" id="remoteslicing_plate_name" class="input-medium" data-bind="value: plateName, valueUpdate: 'input'">
                <span class="muted" data-bind="text: bedText"></span>
            </div>
            <div class="rs-bed-wrap">
                <canvas id="remoteslicing_bed"></canvas>
                <div class="rs-bed-hint muted" data-bind="visible: !items().length">Add models from the library to place them on the bed.</div>
            </div>
            <div class="rs-problems">
                <span class="rs-bad" data-bind="visible: outsideNames().length, text: 'Outside the bed: ' + outsideNames().join(', ')"></span>
                <span class="rs-warn" data-bind="visible: overlapText(), text: overlapText"></span>
            </div>

            <div class="rs-table-wrap" data-bind="visible: items().length">
                <table class="table table-condensed rs-table rs-plate-table">
                    <thead><tr><th>Model</th><th>Extruder</th><th>X</th><th>Y</th><th>Rot.</th><th>Tilt</th><th></th></tr></thead>
                    <tbody data-bind="foreach: items">
                        <tr data-bind="css: {'rs-selected': $parent.selectedUid() === uid}, click: function () { $parent.selectItem(uid); return true; }">
                            <td class="rs-name">
                                <span data-bind="text: name"></span>
                                <span class="muted" data-bind="visible: loading">loading…</span>
                                <span class="rs-bad" data-bind="visible: error, text: error"></span>
                            </td>
                            <td>
                                <span class="rs-swatch" data-bind="style: {background: $parent.extruderColor(extruder())}"></span>
                                <select class="input-small rs-extruder" data-bind="options: $parent.extruderOptions, optionsText: 'label', optionsValue: 'nr', value: extruder, valueAllowUnset: true, optionsAfterRender: $parent.disableExtruder"></select>
                            </td>
                            <td><input type="number" step="1" class="rs-num" data-bind="value: x"></td>
                            <td><input type="number" step="1" class="rs-num" data-bind="value: y"></td>
                            <td><input type="number" step="5" class="rs-num" data-bind="value: rotation"></td>
                            <td class="rs-tilt">
                                <button class="btn btn-mini" title="Tip 90° about X (front-to-back)" data-bind="click: function () { $parent.tilt('x', $data); }, clickBubble: false"><i class="fas fa-redo"></i> X</button>
                                <button class="btn btn-mini" title="Tip 90° about Y (side-to-side)" data-bind="click: function () { $parent.tilt('y', $data); }, clickBubble: false"><i class="fas fa-redo"></i> Y</button>
                                <span class="muted rs-meta" data-bind="text: tiltText"></span>
                            </td>
                            <td class="rs-actions">
                                <button class="btn btn-mini" title="Duplicate" data-bind="click: $parent.duplicateItem"><i class="fas fa-clone"></i></button>
                                <button class="btn btn-mini" title="Remove from plate" data-bind="click: $parent.removeItem"><i class="fas fa-times"></i></button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="rs-slice-buttons">
                <button class="btn btn-primary" data-bind="enable: canSlice, click: function () { slice(false); }"><i class="fas fa-layer-group"></i> Slice &amp; upload</button>
                <button class="btn btn-success" data-bind="enable: canSliceAndPrint, click: function () { slice(true); }"><i class="fas fa-print"></i> Slice, upload &amp; print</button>
                <span class="muted" data-bind="text: sliceBlocker"></span>
            </div>
        </div>

        <div class="rs-side">
            <div class="rs-library-row" data-bind="css: {'rs-preview-full': previewMode() === 'full'}">
                <div class="rs-section rs-models">
                    <h4>Models
                        <button class="btn btn-mini pull-right" title="Show the preview" data-bind="visible: previewMode() === 'collapsed', click: function () { setPreviewMode('compact'); }"><i class="far fa-eye"></i> Preview</button>
                    </h4>
                    <div class="rs-upload">
                        <input type="file" id="remoteslicing_file" accept=".stl,.sldprt" multiple data-bind="event: {change: uploadSelected}, enable: canUpload">
                        <button class="btn btn-small" data-bind="click: toggleBrowser, enable: canUpload"><i class="fab fa-dropbox"></i> From PC Dropbox</button>
                    </div>
                    <div class="progress progress-striped active rs-progress" data-bind="visible: uploadProgress() !== null">
                        <div class="bar" data-bind="style: {width: (uploadProgress() || 0) + '%'}"></div>
                    </div>

                    <div class="rs-browser" data-bind="visible: browserVisible">
                        <label class="checkbox rs-remember muted"><input type="checkbox" data-bind="checked: rememberFolder"> Remember folder</label>
                        <div class="rs-crumbs">
                            <a href="#" data-bind="click: function () { browse(''); }">Dropbox</a>
                            <!-- ko foreach: crumbs -->
                            / <a href="#" data-bind="text: name, click: function () { $parent.browse(path); }"></a>
                            <!-- /ko -->
                        </div>
                        <div class="muted" data-bind="visible: browserLoading">Asking the PC…</div>
                        <div class="rs-bad" data-bind="visible: browserError, text: browserError"></div>
                        <ul class="rs-entries" data-bind="visible: !browserLoading()">
                            <!-- ko foreach: browserDirs -->
                            <li class="rs-entry"><a href="#" data-bind="click: function () { $parent.browse($parent.joinPath(name)); }"><i class="fas fa-folder"></i> <span data-bind="text: name"></span></a></li>
                            <!-- /ko -->
                            <!-- ko foreach: browserFiles -->
                            <li class="rs-entry">
                                <a href="#" data-bind="click: function () { $parent.fetchFile($data); }"><i class="fas" data-bind="css: /\.sldprt$/i.test(name) ? 'fa-cube' : 'fa-file'"></i> <span data-bind="text: name"></span></a>
                                <span class="muted rs-meta" data-bind="text: $parent.formatSize(size)"></span>
                                <span class="muted" data-bind="visible: $parent.fetching()[$parent.joinPath(name)]">fetching…</span>
                            </li>
                            <!-- /ko -->
                            <li class="muted" data-bind="visible: !browserDirs().length && !browserFiles().length && !browserError()">No STL or SolidWorks files here.</li>
                            <li class="muted" data-bind="visible: browserTruncated">Only the first 2000 entries are shown.</li>
                        </ul>
                    </div>

                    <div class="rs-table-wrap">
                        <table class="table table-condensed rs-table rs-model-table" data-bind="visible: models().length">
                            <tbody data-bind="foreach: models">
                                <tr>
                                    <td class="rs-name"><a href="#" title="Preview" data-bind="text: name, click: $parent.previewModel"></a>
                                        <span class="label rs-src" data-bind="text: source, visible: source !== 'upload'"></span></td>
                                    <td class="muted rs-meta" data-bind="text: $parent.formatSize(size)"></td>
                                    <td class="rs-actions">
                                        <button class="btn btn-mini btn-primary" data-bind="click: $parent.addToPlate"><i class="fas fa-plus"></i> Add</button>
                                        <button class="btn btn-mini" title="Delete" data-bind="click: $parent.deleteModel, enable: $parent.canDelete"><i class="far fa-trash-alt"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="muted" data-bind="visible: !models().length">No models yet. Upload an STL or SolidWorks part, or pick one from your PC's Dropbox.</p>
                    </div>
                </div>
                <div class="rs-section rs-preview" data-bind="visible: previewMode() !== 'collapsed'">
                    <h4>Preview
                        <span class="muted rs-meta rs-preview-name" data-bind="text: previewTitle"></span>
                        <span class="pull-right rs-preview-modes">
                            <button class="btn btn-mini" data-bind="attr: {title: previewMode() === 'full' ? 'Make it smaller, next to the models' : 'Use the full width'}, click: function () { setPreviewMode(previewMode() === 'full' ? 'compact' : 'full'); }"><i class="fas" data-bind="css: previewMode() === 'full' ? 'fa-compress-alt' : 'fa-expand-alt'"></i></button>
                            <button class="btn btn-mini" title="Hide the preview" data-bind="click: function () { setPreviewMode('collapsed'); }"><i class="fas fa-times"></i></button>
                        </span>
                    </h4>
                    <div class="rs-preview-wrap">
                        <canvas id="remoteslicing_preview" title="Drag to turn it around, double-click to reset"></canvas>
                        <div class="rs-preview-hint muted" data-bind="visible: !previewTarget()">Select a model on the plate, or click a model's name in the list.</div>
                        <div class="rs-preview-hint muted" data-bind="visible: previewTarget() && previewBusy()">Loading…</div>
                    </div>
                    <div class="rs-preview-bar">
                        <div class="btn-group">
                            <button class="btn btn-mini" data-bind="click: function () { setView(-30, 30); }">Iso</button>
                            <button class="btn btn-mini" data-bind="click: function () { setView(0, 90); }">Top</button>
                            <button class="btn btn-mini" data-bind="click: function () { setView(0, 0); }">Front</button>
                            <button class="btn btn-mini" data-bind="click: function () { setView(90, 0); }">Side</button>
                        </div>
                        <span class="muted rs-meta" data-bind="text: previewSize"></span>
                    </div>
                    <div class="rs-preview-bar rs-orient" data-bind="visible: previewTarget">
                        <div class="btn-group">
                            <button class="btn btn-mini" title="Turn 90° about X (tip it forwards)" data-bind="click: function () { orient('x'); }"><i class="fas fa-redo"></i> X</button>
                            <button class="btn btn-mini" title="Turn 90° about Y (tip it sideways)" data-bind="click: function () { orient('y'); }"><i class="fas fa-redo"></i> Y</button>
                            <button class="btn btn-mini" title="Turn 90° about Z (rotate on the bed)" data-bind="click: function () { orient('z'); }"><i class="fas fa-redo"></i> Z</button>
                            <button class="btn btn-mini" title="Back to how the file lies" data-bind="click: resetOrientation"><i class="fas fa-undo"></i></button>
                        </div>
                        <span class="muted rs-meta" data-bind="text: previewOrientText"></span>
                        <button class="btn btn-mini btn-primary" title="Add it to the plate in this orientation" data-bind="visible: previewIsLibrary, click: addPreviewed, enable: canUpload"><i class="fas fa-plus"></i> Add to plate</button>
                    </div>
                </div>
            </div>

            <div class="rs-section">
                <h4>Jobs <button class="btn btn-mini pull-right" data-bind="click: clearFinished, visible: hasFinished">Clear finished</button></h4>
                <div data-bind="foreach: tasks">
                    <div class="rs-task">
                        <div class="rs-task-head">
                            <span class="label" data-bind="text: state, css: $parent.stateClass(state())"></span>
                            <strong data-bind="text: title"></strong>
                            <button class="btn btn-mini pull-right" data-bind="visible: cancellable, click: $parent.cancelTask">Cancel</button>
                        </div>
                        <div class="progress rs-progress" data-bind="visible: state() === 'running'">
                            <div class="bar" data-bind="style: {width: Math.round(progress() * 100) + '%'}"></div>
                        </div>
                        <div class="muted rs-meta" data-bind="visible: state() === 'running' || state() === 'queued', text: stage"></div>
                        <div class="rs-bad" data-bind="visible: error, text: error"></div>
                        <div class="rs-meta" data-bind="visible: details, text: details"></div>
                        <div class="rs-meta" data-bind="visible: printNote, text: printNote, css: printStarted() ? 'rs-ok' : 'rs-warn'"></div>
                    </div>
                </div>
                <p class="muted" data-bind="visible: !tasks().length">No jobs yet.</p>
            </div>
        </div>
    </div>
</div>
